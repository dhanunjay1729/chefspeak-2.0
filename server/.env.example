# Free Gemini is always tried first. Keep this project on the free tier.
GEMINI_API_KEY=your_gemini_key

# Optional paid fallback: GPT-6 Luna through Vercel AI Gateway.
# Keep the key on the backend; never use a VITE_ variable.
# Set true on Render to enable the fallback.
AI_GATEWAY_API_KEY=
AI_PAID_FALLBACK_ENABLED=false

# Google TTS (for production, paste entire JSON as single line)
GOOGLE_TTS_CREDENTIALS=

# For local development only
GOOGLE_TTS_KEY_PATH=../google-tts-key.json

# Unsplash & Google Search
UNSPLASH_API_KEY=your_unsplash_key
GOOGLE_CSE_KEY=your_google_cse_key
GOOGLE_CSE_CX=your_cse_id

# Port
PORT=3002
